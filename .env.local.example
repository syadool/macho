# `npm run dev`（next dev）用。.env.local にコピーして値を設定してください。
# DBはローカルD1（`npm run db:migrate:local` で作成）を使います。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth（`openssl rand -base64 32` で生成）
BETTER_AUTH_SECRET=replace-with-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console > APIとサービス > 認証情報 > OAuth クライアントID で作成してください。
# 承認済みのリダイレクトURI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server-only keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# AI suggestion guardrails
MONTHLY_AI_CALL_LIMIT=3000
AI_CACHE_TTL_HOURS=1
AI_PENDING_RESERVATION_TTL_MINUTES=15
AI_MAX_TOKENS=3000

# Stripe Billing
STRIPE_RESTRICTED_KEY=rk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PORTAL_CONFIGURATION_ID=bpc_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_GO=price_xxx
STRIPE_PRICE_PLUS=price_xxx
STRIPE_PRICE_PRO=price_xxx
